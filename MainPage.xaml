<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TacxRpmApp.MainPage"
    Title="Tacx RPM Controller"
    BackgroundColor="#F5F7FA">
    <Grid Padding="12,10"
        RowSpacing="8"
        RowDefinitions="Auto,*,*,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Label Text="TACX NEO 2T"
                FontSize="22"
                FontAttributes="Bold"
                LineBreakMode="NoWrap"
                TextColor="#26384A"
                VerticalOptions="Center" />
            <Button Grid.Column="1"
                x:Name="ConnectButton"
                Text="CONECTAR"
                FontSize="16"
                FontAttributes="Bold"
                Padding="16,10"
                Clicked="OnConnectClicked" />
            <Button Grid.Column="2"
                Text="CONFIG"
                FontSize="16"
                FontAttributes="Bold"
                Padding="16,10"
                Clicked="OnConfigClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Grid Grid.Column="0" BackgroundColor="#E84C3D">
                <Button x:Name="UphillApplyButton"
                    BackgroundColor="#B9C0C8"
                    Text=""
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    Clicked="OnUphillApply" />
                <VerticalStackLayout InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="2">
                    <Label Text="UPHILL"
                        TextColor="#34495E"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label x:Name="UphillValueLabel"
                        FontSize="17"
                        TextColor="#34495E"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="0">
                <Button Text="−"
                    Grid.Row="1"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnUphillMinus" />
                <Button Text="+"
                    Grid.Row="0"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnUphillPlus" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Grid Grid.Column="0" BackgroundColor="#39A96B">
                <Button x:Name="CruiseApplyButton"
                    BackgroundColor="#B9C0C8"
                    Text=""
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    Clicked="OnCruiseApply" />
                <VerticalStackLayout InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="2">
                    <Label Text="CRUISE"
                        TextColor="#34495E"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label x:Name="CruiseValueLabel"
                        FontSize="17"
                        TextColor="#34495E"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="0">
                <Button Text="−"
                    Grid.Row="1"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnCruiseMinus" />
                <Button Text="+"
                    Grid.Row="0"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnCruisePlus" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Grid Grid.Column="0" BackgroundColor="#2589D9">
                <Button x:Name="DownhillApplyButton"
                    BackgroundColor="#B9C0C8"
                    Text=""
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    Clicked="OnDownhillApply" />
                <VerticalStackLayout InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="2">
                    <Label Text="DOWNHILL"
                        TextColor="#34495E"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label x:Name="DownhillValueLabel"
                        FontSize="17"
                        TextColor="#34495E"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="0">
                <Button Text="−"
                    Grid.Row="1"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnDownhillMinus" />
                <Button Text="+"
                    Grid.Row="0"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnDownhillPlus" />
            </Grid>
        </Grid>
        <Label Grid.Row="4"
            x:Name="StatusLabel"
            FontSize="15"
            TextColor="#596979"
            HorizontalTextAlignment="Center"
            LineBreakMode="TailTruncation" />
    </Grid>
</ContentPage>