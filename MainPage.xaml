<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TacxRpmApp.MainPage"
    Title="Tacx RPM Controller"
    BackgroundColor="#F5F7FA">
    <Grid Padding="12,10"
        RowSpacing="8"
        RowDefinitions="Auto,*,*,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Label Text="TACX NEO 2T"
                FontSize="22"
                FontAttributes="Bold"
                LineBreakMode="NoWrap"
                TextColor="#26384A"
                VerticalOptions="Center" />
            <Button Grid.Column="1"
                Text="{Binding ConnectButtonText}"
                FontSize="16"
                FontAttributes="Bold"
                Padding="16,10"
                Clicked="OnConnectClicked">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding ConnectButtonState}" Value="PermissionDenied">
                        <Setter Property="BackgroundColor" Value="#B9C0C8" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button" Binding="{Binding ConnectButtonState}" Value="Connected">
                        <Setter Property="BackgroundColor" Value="#39A96B" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2"
                Text="CONFIG"
                FontSize="16"
                FontAttributes="Bold"
                Padding="16,10"
                Clicked="OnConfigClicked" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Grid Grid.Column="0" BackgroundColor="#E84C3D">
                <Button BackgroundColor="#B9C0C8"
                    Text=""
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    Command="{Binding UphillApplyCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActivePreset}" Value="Uphill">
                            <Setter Property="BackgroundColor" Value="#E84C3D" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <VerticalStackLayout InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="2">
                    <Label Text="UPHILL"
                        TextColor="#34495E"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label Text="{Binding UphillValueText}"
                        FontSize="17"
                        TextColor="#34495E"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="0">
                <Button Text="−"
                    Grid.Row="1"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Command="{Binding UphillMinusCommand}" />
                <Button Text="+"
                    Grid.Row="0"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Command="{Binding UphillPlusCommand}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Grid Grid.Column="0" BackgroundColor="#39A96B">
                <Button BackgroundColor="#B9C0C8"
                    Text=""
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    Command="{Binding CruiseApplyCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActivePreset}" Value="Cruise">
                            <Setter Property="BackgroundColor" Value="#39A96B" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <VerticalStackLayout InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="2">
                    <Label Text="CRUISE"
                        TextColor="#34495E"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label Text="{Binding CruiseValueText}"
                        FontSize="17"
                        TextColor="#34495E"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="0">
                <Button Text="−"
                    Grid.Row="1"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Command="{Binding CruiseMinusCommand}" />
                <Button Text="+"
                    Grid.Row="0"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Command="{Binding CruisePlusCommand}" />
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Grid Grid.Column="0" BackgroundColor="#2589D9">
                <Button BackgroundColor="#B9C0C8"
                    Text=""
                    TextColor="White"
                    FontSize="30"
                    FontAttributes="Bold"
                    Command="{Binding DownhillApplyCommand}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding ActivePreset}" Value="Downhill">
                            <Setter Property="BackgroundColor" Value="#2589D9" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <VerticalStackLayout InputTransparent="True"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="2">
                    <Label Text="DOWNHILL"
                        TextColor="#34495E"
                        FontSize="23"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />
                    <Label Text="{Binding DownhillValueText}"
                        FontSize="17"
                        TextColor="#34495E"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Grid>
            <Grid Grid.Column="1" RowDefinitions="*,*" RowSpacing="0">
                <Button Text="−"
                    Grid.Row="1"
                    FontSize="48"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Command="{Binding DownhillMinusCommand}" />
                <Button Text="+"
                    Grid.Row="0"
                    FontSize="44"
                    FontAttributes="Bold"
                    TextColor="White"
                    BackgroundColor="#30465A"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Command="{Binding DownhillPlusCommand}" />
            </Grid>
        </Grid>
        <Label Grid.Row="4"
            Text="{Binding StatusText}"
            FontSize="15"
            TextColor="#596979"
            HorizontalTextAlignment="Center"
            LineBreakMode="TailTruncation" />
    </Grid>
</ContentPage>