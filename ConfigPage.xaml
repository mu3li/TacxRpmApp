<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TacxRpmApp.ConfigPage"
             Title="Config"
             BackgroundColor="#F5F7FA">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20">
            <Label Text="CONFIGURAÇÃO"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#26384A" />
            <Label Text="Defina os valores FE-C (0-200) e o passo dos botões."
                   FontSize="17"
                   TextColor="#596979" />

            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="14">
                <Label Text="UPHILL" FontSize="22" VerticalOptions="Center" TextColor="#596979"/>
                <Entry Grid.Column="1" Text="{Binding UphillText}" WidthRequest="110" FontSize="24" Keyboard="Numeric" HorizontalTextAlignment="Center" TextColor="#596979"/>
                <Label Grid.Row="1" Text="CRUISE" FontSize="22" VerticalOptions="Center" TextColor="#596979"/>
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding CruiseText}" WidthRequest="110" FontSize="24" Keyboard="Numeric" HorizontalTextAlignment="Center" TextColor="#596979"/>
                <Label Grid.Row="2" Text="DOWNHILL" FontSize="22" VerticalOptions="Center" TextColor="#596979"/>
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding DownhillText}" WidthRequest="110" FontSize="24" Keyboard="Numeric" HorizontalTextAlignment="Center" TextColor="#596979"/>
                <Label Grid.Row="3" Text="PASSO" FontSize="22" VerticalOptions="Center" TextColor="#596979"/>
                <Entry Grid.Row="3" Grid.Column="1" Text="{Binding IncrementText}" WidthRequest="110" FontSize="24" Keyboard="Numeric" HorizontalTextAlignment="Center" TextColor="#596979"/>
            </Grid>

            <Button Text="GUARDAR"
                    FontSize="24"
                    FontAttributes="Bold"
                    HeightRequest="72"
                    Command="{Binding SaveCommand}" />
            <Label Text="{Binding StatusText}"
                   TextColor="#596979"
                   FontSize="17"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
